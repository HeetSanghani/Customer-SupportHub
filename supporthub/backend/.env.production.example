# ─── App ───────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=change_this_to_a_secure_random_string_min_32_chars
FRONTEND_URL=https://your-production-domain.com

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://supporthub:PROD_DB_PASSWORD@db:5432/supporthub
BUSINESS_DB_HOST=mysql
BUSINESS_DB_PORT=3306
BUSINESS_DB_USER=root
BUSINESS_DB_PASSWORD=PROD_MYSQL_PASSWORD
BUSINESS_DB_NAME=supporthub_business

# ─── Redis ─────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Auth ──────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI Providers ──────────────────────────────────────
GEMINI_API_KEY=YOUR_PRODUCTION_GEMINI_API_KEY
OPENAI_API_KEY=YOUR_PRODUCTION_OPENAI_API_KEY
ANTHROPIC_API_KEY=YOUR_PRODUCTION_ANTHROPIC_API_KEY

# ─── Storage & Integrations ───────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_KEY
POSTMARK_SERVER_TOKEN=YOUR_POSTMARK_TOKEN
