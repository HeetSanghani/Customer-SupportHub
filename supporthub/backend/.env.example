# ─── App Configuration ────────────────────────────────
APP_ENV=development
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32
FRONTEND_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://supporthub:supporthub_dev@localhost:5433/supporthub

# ─── Redis & Celery ────────────────────────────────────
REDIS_URL=redis://localhost:6381/0
CELERY_BROKER_URL=redis://localhost:6381/1
CELERY_RESULT_BACKEND=redis://localhost:6381/2

# ─── Auth Tokens ───────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Claude AI / Anthropic ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
AI_DEFAULT_MODEL=claude-sonnet-4-5
AI_CHEAP_MODEL=claude-haiku-4-5
AI_CONFIDENCE_THRESHOLD=0.75

# ─── Email (Postmark) ──────────────────────────────────
POSTMARK_SERVER_TOKEN=your_postmark_server_token_here
POSTMARK_FROM_EMAIL=support@yourdomain.com
POSTMARK_INBOUND_HASH=your_inbound_hash_here

# ─── File Storage (Supabase) ───────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_BUCKET=supporthub-attachments

# ─── Sentry ────────────────────────────────────────────
SENTRY_DSN=your_sentry_dsn_here

# ─── Meta (WhatsApp / Instagram / Facebook) ────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=supporthub_verify
WHATSAPP_PHONE_ID=your_whatsapp_phone_id
PAGE_ACCESS_TOKEN=your_page_access_token
INSTAGRAM_PAGE_ID=your_instagram_page_id
FACEBOOK_PAGE_ID=your_facebook_page_id

# ─── AI / LLM Providers ───────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ─── Mailgun Inbound & Outbound Email ──────────────────
MAILGUN_DOMAIN=sandbox54bf194097414b04809437336c4b5e19.mailgun.org
MAILGUN_API_KEY=your_mailgun_api_key_here
