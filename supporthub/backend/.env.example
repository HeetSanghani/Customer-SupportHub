# ─── App Configuration ────────────────────────────────
APP_ENV=development
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32
FRONTEND_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://supporthub:supporthub_dev@localhost:5433/supporthub

# ─── Redis & Celery ────────────────────────────────────
REDIS_URL=redis://localhost:6381/0
CELERY_BROKER_URL=redis://localhost:6381/1
CELERY_RESULT_BACKEND=redis://localhost:6381/2

# ─── Auth Tokens ───────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI / LLM Providers ───────────────────────────────
# Primary: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_DEFAULT_MODEL=gemini-2.5-flash-latest
AI_CHEAP_MODEL=gemini-flash-lite-latest
AI_CONFIDENCE_THRESHOLD=0.75

# Optional fallbacks
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ─── Email — Mailgun Inbound & Outbound ───────────────
MAILGUN_DOMAIN=your_mailgun_domain.mailgun.org
MAILGUN_API_KEY=your_mailgun_api_key_here

# ─── Meta — WhatsApp ──────────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=supporthub_verify
WHATSAPP_PHONE_ID=your_whatsapp_phone_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
PAGE_ACCESS_TOKEN=your_page_access_token
WHATSAPP_VERIFY_TOKEN=supporthub_verify

# ─── Meta — Instagram ─────────────────────────────────
INSTAGRAM_PAGE_ID=your_instagram_page_id
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
IG_PAGE_ID=your_instagram_ig_page_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# ─── Meta — Facebook Messenger ────────────────────────
FACEBOOK_PAGE_ID=your_facebook_page_id
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_VERIFY_TOKEN=supporthub_verify
FB_PAGE_ID=your_facebook_page_id

# ─── File Storage (Supabase) ───────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_BUCKET=supporthub-attachments

# ─── Monitoring — Sentry ──────────────────────────────
SENTRY_DSN=your_sentry_dsn_here

# ─── Support Contact ──────────────────────────────────
SUPPORT_CONTACT_EMAIL=support@yourdomain.com
